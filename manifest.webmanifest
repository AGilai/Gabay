{
  "name": "גבאי",
  "short_name": "גבאי",
  "description": "עליות לתורה בימי חול",
  "lang": "he",
  "dir": "rtl",
  "display": "standalone",
  "orientation": "portrait",
  "start_url": "./#reading",
  "scope": "./",
  "theme_color": "#11161e",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/zip",
            ".zip",
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  }
}
